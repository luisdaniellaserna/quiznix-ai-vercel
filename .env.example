VITE_DEEPSEEK_API_KEY=""
VITE_WS_URL="" # Optional. WebSocket URL for group mode; defaults to ws://<page host>:8787 (wss:// when page is https). For production (e.g. Vercel) set to wss://<your-ws-host> — the Node server in /server must be hosted separately (Render/Fly/Railway) as Vercel cannot run persistent WebSockets.
VITE_REPORT_EMAIL="" # Optional. Recipient of the in-app bug report; mailto is sent unaddressed when empty
